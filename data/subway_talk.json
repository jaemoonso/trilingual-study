{"en": [[0.0, "t", "Where can I buy a ticket?", "웨어 캔 아이 바이 어 티킷?", "표는 어디서 사요?"], [2.27, "t", "You can use the machine over there.", "유 캔 유즈 더 머쉰 오버 데어.", "저쪽 기계에서 사시면 돼요."], [4.86, "t", "Could you show me how to use it?", "쿠쥬 쇼 미 하우 투 유즈 잇?", "사용법 좀 알려 주시겠어요?"], [7.33, "t", "Where are you going?", "웨어 라 유 고잉?", "어디까지 가세요?"], [9.19, "t", "I'm going to City Hall.", "아임 고잉 투 씨리 홀.", "시청까지 가요."], [11.45, "t", "That's two dollars fifty.", "대츠 투 달러즈 피프티.", "요금은 이만큼이에요."], [13.68, "t", "Do you have a one-day pass?", "두 유 해버 원 데이 패스?", "일일권 있어요?"], [16.04, "t", "Which line goes to City Hall?", "위치 라인 고우즈 투 씨리 홀?", "시청 가려면 몇 호선이에요?"], [18.57, "t", "Take the green line.", "테이크 더 그린 라인.", "초록색 노선을 타세요."], [20.66, "t", "Which platform should I go to?", "위치 플랫폼 슈드 아이 고 투?", "몇 번 승강장으로 가요?"], [23.17, "t", "Platform two, downstairs.", "플랫폼 투, 다운스테어즈.", "아래층 이 번 승강장이에요."], [25.57, "t", "Does this train go to City Hall?", "더즈 디스 트레인 고 투 씨리 홀?", "이 열차 시청 가요?"], [28.15, "t", "No, you need the other side.", "노우, 유 니드 디 아더 싸이드.", "아니요, 반대편에서 타야 해요."], [30.56, "t", "How many stops is it?", "하우 메니 스탑스 이즈 잇?", "몇 정거장이에요?"], [32.7, "t", "It's four stops from here.", "이츠 포 스탑스 프럼 히어.", "여기서 네 정거장이에요."], [35.0, "t", "Do I need to transfer?", "두 아이 니드 투 트랜스퍼?", "갈아타야 해요?"], [37.16, "t", "Yes, change at Central Station.", "예스, 체인지 앳 쎈트럴 스테이션.", "네, 중앙역에서 갈아타세요."], [39.94, "t", "Excuse me, I'm getting off.", "익스큐즈 미, 아임 게팅 오프.", "실례합니다, 내려요."], [42.56, "t", "Would you like to sit here?", "우쥬 라익 투 씻 히어?", "여기 앉으시겠어요?"], [44.74, "t", "No, thank you. I'm getting off soon.", "노우, 쌩큐. 아임 게팅 오프 쑨.", "괜찮아요. 곧 내려요."], [47.69, "t", "I got off at the wrong station.", "아이 갓 오프 앳 더 롱 스테이션.", "역을 잘못 내렸어요."], [50.2, "t", "Just wait for the next train.", "저스트 웨이트 포 더 넥스트 트레인.", "다음 열차를 기다리면 돼요."], [52.59, "t", "Which exit should I take for City Hall?", "위치 엑싯 슈드 아이 테이크 포 씨리 홀?", "시청은 몇 번 출구예요?"], [55.59, "t", "Take exit three.", "테이크 엑싯 쓰리.", "삼 번 출구예요."]], "ja": [[0.0, "t", "切符はどこで買えますか。", "킵푸와 도코데 카에마스카.", "표는 어디서 사요?"], [2.59, "t", "あちらの券売機で買えます。", "아치라노 켐바이키데 카에마스.", "저쪽 기계에서 사시면 돼요."], [5.32, "t", "使い方を教えてもらえますか。", "츠카이카타오 오시에테 모라에마스카.", "사용법 좀 알려 주시겠어요?"], [8.32, "t", "どちらまで行かれますか。", "도치라마데 이카레마스카.", "어디까지 가세요?"], [10.83, "t", "市役所までです。", "시야쿠쇼마데데스.", "시청까지 가요."], [12.98, "t", "二百五十円です。", "니햐쿠 고쥬-엔데스.", "요금은 이만큼이에요."], [15.24, "t", "一日乗車券はありますか。", "이치니치 죠-샤켕와 아리마스카.", "일일권 있어요?"], [18.28, "t", "市役所へ行くのは何線ですか。", "시야쿠쇼에 이쿠노와 나니센데스카.", "시청 가려면 몇 호선이에요?"], [21.39, "t", "緑の線に乗ってください。", "미도리노 센니 놋테 쿠다사이.", "초록색 노선을 타세요."], [24.26, "t", "何番線に行けばいいですか。", "난반센니 이케바 이-데스카.", "몇 번 승강장으로 가요?"], [27.21, "t", "下の二番線です。", "시타노 니반센데스.", "아래층 이 번 승강장이에요."], [29.54, "t", "この電車は市役所に行きますか。", "코노 덴샤와 시야쿠쇼니 이키마스카.", "이 열차 시청 가요?"], [32.71, "t", "いいえ、反対側の電車です。", "이-에, 한타이가와노 덴샤데스.", "아니요, 반대편에서 타야 해요."], [35.64, "t", "何駅ありますか。", "낭에키 아리마스카.", "몇 정거장이에요?"], [37.88, "t", "ここから四駅です。", "코코카라 욘에키데스.", "여기서 네 정거장이에요."], [40.2, "t", "乗り換えは必要ですか。", "노리카에와 히츠요-데스카.", "갈아타야 해요?"], [42.76, "t", "はい、中央駅で乗り換えてください。", "하이, 츄-오-에키데 노리카에테 쿠다사이.", "네, 중앙역에서 갈아타세요."], [46.02, "t", "すみません、降ります。", "스미마셍, 오리마스.", "실례합니다, 내려요."], [48.25, "t", "こちらに座りますか。", "코치라니 스와리마스카.", "여기 앉으시겠어요?"], [50.66, "t", "大丈夫です。すぐ降りますので。", "다이죠-부데스. 스구 오리마스노데.", "괜찮아요. 곧 내려요."], [54.06, "t", "降りる駅を間違えました。", "오리루 에키오 마치가에마시타.", "역을 잘못 내렸어요."], [56.67, "t", "次の電車を待てば大丈夫ですよ。", "츠기노 덴샤오 마테바 다이죠-부데스요.", "다음 열차를 기다리면 돼요."], [60.08, "t", "市役所はどの出口ですか。", "시야쿠쇼와 도노 데구치데스카.", "시청은 몇 번 출구예요?"], [62.9, "t", "三番出口です。", "삼반 데구치데스.", "삼 번 출구예요."]], "zh": [[0.0, "t", "请问在哪里买票？", "칭원 짜이 나리 마이퍄오?", "표는 어디서 사요?"], [2.41, "t", "在那边的机器上买。", "짜이 나볜 더 치치 상 마이.", "저쪽 기계에서 사시면 돼요."], [4.87, "t", "可以教我怎么用吗？", "커이 쟈오 워 쩐머 융 마?", "사용법 좀 알려 주시겠어요?"], [7.05, "t", "您要去哪儿？", "닌 야오 취 날?", "어디까지 가세요?"], [8.96, "t", "我要去市政府。", "워 야오 취 스정푸.", "시청까지 가요."], [11.15, "t", "三块钱。", "싼 콰이 쳰.", "요금은 이만큼이에요."], [13.06, "t", "有一日票吗？", "여우 이르퍄오 마?", "일일권 있어요?"], [14.94, "t", "去市政府坐几号线？", "취 스정푸 쭤 지 하오 셴?", "시청 가려면 몇 호선이에요?"], [17.69, "t", "坐绿线。", "쭤 뤼셴.", "초록색 노선을 타세요."], [19.42, "t", "我应该去几号站台？", "워 잉까이 취 지 하오 쨘타이?", "몇 번 승강장으로 가요?"], [22.04, "t", "二号站台，在楼下。", "얼 하오 쨘타이, 짜이 러우샤.", "아래층 이 번 승강장이에요."], [24.49, "t", "这趟车到市政府吗？", "쩌 탕 처 따오 스정푸 마?", "이 열차 시청 가요?"], [26.93, "t", "不到，你要去对面坐。", "부 따오, 니 야오 취 뚜이몐 쭤.", "아니요, 반대편에서 타야 해요."], [29.43, "t", "还有几站？", "하이 여우 지 쨘?", "몇 정거장이에요?"], [31.32, "t", "从这儿还有四站。", "충 쩔 하이 여우 쓰 쨘.", "여기서 네 정거장이에요."], [33.61, "t", "需要换乘吗？", "쉬야오 환청 마?", "갈아타야 해요?"], [35.6, "t", "要，在中央站换乘。", "야오, 짜이 중양 쨘 환청.", "네, 중앙역에서 갈아타세요."], [38.08, "t", "不好意思，我要下车。", "뿌 하오이쓰, 워 야오 샤처.", "실례합니다, 내려요."], [40.53, "t", "您要坐这儿吗？", "닌 야오 쭤 쩔 마?", "여기 앉으시겠어요?"], [42.52, "t", "不用了，谢谢。我马上就下车。", "부융 러, 셰셰. 워 마상 쥬 샤처.", "괜찮아요. 곧 내려요."], [45.48, "t", "我下错站了。", "워 샤추어 쨘 러.", "역을 잘못 내렸어요."], [47.53, "t", "等下一趟车就行。", "덩 샤 이 탕 처 쥬 싱.", "다음 열차를 기다리면 돼요."], [49.97, "t", "去市政府走哪个出口？", "취 스정푸 저우 나거 추커우?", "시청은 몇 번 출구예요?"], [52.8, "t", "走三号口。", "저우 싼 하오 커우.", "삼 번 출구예요."]]}