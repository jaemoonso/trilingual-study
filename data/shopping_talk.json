{"en": [[0.0, "t", "Can I help you find something?", "캔 아이 헬퓨 파인드 썸씽?", "찾으시는 거 있으세요?"], [2.35, "t", "I'm just looking, thank you.", "아임 저스트 루킹, 쌩큐.", "그냥 구경하는 거예요, 감사합니다."], [4.73, "t", "Can I try this on?", "캔 아이 트라이 디스 온?", "이거 입어 봐도 돼요?"], [6.78, "t", "Of course. The fitting room is over there.", "어브 코스. 더 피팅 룸 이즈 오버 데어.", "물론이죠. 탈의실은 저쪽이에요."], [9.8, "t", "It's a little tight.", "이처 리틀 타이트.", "좀 껴요."], [11.71, "t", "Do you have a bigger size?", "두 유 해버 비거 싸이즈?", "더 큰 사이즈 있어요?"], [13.93, "t", "Do you have a smaller size?", "두 유 해버 스몰러 싸이즈?", "더 작은 사이즈 있어요?"], [16.29, "t", "Let me check for you.", "렛 미 첵 포 유.", "확인해 드릴게요."], [18.3, "t", "Do you have this in another color?", "두 유 해브 디스 인 어나더 컬러?", "이거 다른 색 있어요?"], [20.96, "t", "We have it in black and blue.", "위 해빗 인 블랙 앤 블루.", "검정과 파랑이 있어요."], [23.32, "t", "I'll try the blue one.", "아일 트라이 더 블루 원.", "파란 걸로 입어 볼게요."], [25.42, "t", "How much is this?", "하우 머치 이즈 디스?", "이거 얼마예요?"], [27.39, "t", "It's fifty dollars.", "이츠 피프티 달러즈.", "이 가격이에요."], [29.37, "t", "Is there any discount?", "이즈 데어 애니 디스카운트?", "할인 있어요?"], [31.44, "t", "It's ten percent off today.", "이츠 텐 퍼센트 오프 투데이.", "오늘은 십 퍼센트 할인이에요."], [33.78, "t", "I'll take it.", "아일 테이킷.", "이걸로 살게요."], [35.49, "t", "Can I return it if there's a problem?", "캔 아이 리터닛 이프 데어저 프라블럼?", "문제가 있으면 반품할 수 있어요?"], [38.34, "t", "Yes, within seven days with the receipt.", "예스, 위딘 쎄븐 데이즈 위드 더 리씨트.", "네, 영수증이 있으면 칠 일 안에 돼요."], [41.45, "t", "The zipper is broken.", "더 지퍼 이즈 브로큰.", "지퍼가 고장 났어요."], [43.62, "t", "Could I get a refund?", "쿠다이 게러 리펀드?", "환불 받을 수 있을까요?"], [45.63, "t", "Do you have the receipt?", "두 유 해브 더 리씨트?", "영수증 있으세요?"], [47.74, "t", "Yes, here it is.", "예스, 히어 잇 이즈.", "네, 여기 있어요."], [49.61, "t", "Could I exchange it?", "쿠다이 익스체인지 잇?", "교환할 수 있을까요?"], [51.66, "t", "Sure. I'll bring you a new one.", "슈어. 아일 브링 유 어 뉴 원.", "네, 새 걸로 가져다드릴게요."]], "ja": [[0.0, "t", "何かお探しですか。", "나니카 오사가시데스카.", "찾으시는 거 있으세요?"], [2.45, "t", "見ているだけです。ありがとうございます。", "미테 이루 다케데스. 아리가토- 고자이마스.", "그냥 구경하는 거예요, 감사합니다."], [6.02, "t", "これを試着してもいいですか。", "코레오 시챠쿠 시테모 이-데스카.", "이거 입어 봐도 돼요?"], [8.83, "t", "もちろんです。試着室はあちらです。", "모치론데스. 시챠쿠시츠와 아치라데스.", "물론이죠. 탈의실은 저쪽이에요."], [12.15, "t", "少しきついです。", "스코시 키츠이데스.", "좀 껴요."], [14.26, "t", "大きいサイズはありますか。", "오-키- 사이즈와 아리마스카.", "더 큰 사이즈 있어요?"], [16.89, "t", "小さいサイズはありますか。", "치-사이 사이즈와 아리마스카.", "더 작은 사이즈 있어요?"], [19.59, "t", "確認してまいります。", "카쿠닌 시테 마이리마스.", "확인해 드릴게요."], [21.94, "t", "これの色違いはありますか。", "코레노 이로치가이와 아리마스카.", "이거 다른 색 있어요?"], [24.68, "t", "黒と青がございます。", "쿠로토 아오가 고자이마스.", "검정과 파랑이 있어요."], [27.07, "t", "青いのを試してみます。", "아오이 노오 타메시테 미마스.", "파란 걸로 입어 볼게요."], [29.53, "t", "これはいくらですか。", "코레와 이쿠라데스카.", "이거 얼마예요?"], [31.82, "t", "五千円です。", "고셍엔데스.", "이 가격이에요."], [33.83, "t", "割引はありますか。", "와리비키와 아리마스카.", "할인 있어요?"], [36.24, "t", "本日は十パーセント引きです。", "혼지츠와 쥽파-센토비키데스.", "오늘은 십 퍼센트 할인이에요."], [39.25, "t", "これをください。", "코레니 시마스.", "이걸로 살게요."], [41.27, "t", "問題があれば返品できますか。", "몬다이가 아레바 헴핑 데키마스카.", "문제가 있으면 반품할 수 있어요?"], [44.41, "t", "はい、レシートがあれば七日以内にできます。", "하이, 레시-토가 아레바 나노카 이나이니 데키마스.", "네, 영수증이 있으면 칠 일 안에 돼요."], [48.16, "t", "ファスナーが壊れています。", "화스나-가 코와레테 이마스.", "지퍼가 고장 났어요."], [50.65, "t", "返金していただけますか。", "헹킨 시테 이타다케마스카.", "환불 받을 수 있을까요?"], [53.31, "t", "レシートはお持ちですか。", "레시-토와 오모치데스카.", "영수증 있으세요?"], [55.85, "t", "はい、これです。", "하이, 코레데스.", "네, 여기 있어요."], [57.81, "t", "交換してもらえますか。", "코-칸 시테 모라에마스카.", "교환할 수 있을까요?"], [60.31, "t", "かしこまりました。新しいものをお持ちします。", "카시코마리마시타. 아타라시- 모노오 오모치시마스.", "네, 새 걸로 가져다드릴게요."]], "zh": [[0.0, "t", "请问想找什么？", "칭원 샹 쟈오 선머?", "찾으시는 거 있으세요?"], [2.26, "t", "我只是看看，谢谢。", "워 즈스 칸칸, 셰셰.", "그냥 구경하는 거예요, 감사합니다."], [4.73, "t", "这件可以试穿吗？", "쩌 졘 커이 스촨 마?", "이거 입어 봐도 돼요?"], [6.93, "t", "当然可以。试衣间在那边。", "땅란 커이. 스이졘 짜이 나볜.", "물론이죠. 탈의실은 저쪽이에요."], [9.73, "t", "有点紧。", "여우뎬 진.", "좀 껴요."], [11.49, "t", "有大一号的吗？", "여우 따 이 하오 더 마?", "더 큰 사이즈 있어요?"], [13.45, "t", "有小一号的吗？", "여우 샤오 이 하오 더 마?", "더 작은 사이즈 있어요?"], [15.44, "t", "我帮您看一下。", "워 빵 닌 칸 이샤.", "확인해 드릴게요."], [17.67, "t", "这件有别的颜色吗？", "쩌 졘 여우 비에 더 옌써 마?", "이거 다른 색 있어요?"], [20.03, "t", "有黑色和蓝色。", "여우 헤이써 허 란써.", "검정과 파랑이 있어요."], [22.29, "t", "我试一下蓝色的。", "워 스 이샤 란써 더.", "파란 걸로 입어 볼게요."], [24.62, "t", "这个多少钱？", "쩌거 뚜어샤오 쳰?", "이거 얼마예요?"], [26.62, "t", "三百块。", "싼바이 콰이.", "이 가격이에요."], [28.45, "t", "有折扣吗？", "여우 저커우 마?", "할인 있어요?"], [30.18, "t", "今天打九折。", "진톈 다 쥬 저.", "오늘은 십 퍼센트 할인이에요."], [32.29, "t", "我买了。", "워 마이 러.", "이걸로 살게요."], [33.81, "t", "如果有问题可以退吗？", "루궈 여우 원티 커이 투이 마?", "문제가 있으면 반품할 수 있어요?"], [36.32, "t", "可以，七天内带小票就行。", "커이, 치 톈 네이 따이 샤오퍄오 쥬 싱.", "네, 영수증이 있으면 칠 일 안에 돼요."], [39.05, "t", "拉链坏了。", "라롄 화이 러.", "지퍼가 고장 났어요."], [40.94, "t", "可以退款吗？", "커이 투이콴 마?", "환불 받을 수 있을까요?"], [42.83, "t", "请问有小票吗？", "칭원 여우 샤오퍄오 마?", "영수증 있으세요?"], [44.86, "t", "有，在这里。", "여우, 짜이 쩌리.", "네, 여기 있어요."], [46.68, "t", "可以换一件吗？", "커이 환 이 졘 마?", "교환할 수 있을까요?"], [48.63, "t", "好的，我给您拿一件新的。", "하오 더, 워 게이 닌 나 이 졘 씬 더.", "네, 새 걸로 가져다드릴게요."]]}