{"en": [[0.0, "t", "Less ice, please.", "레스 아이스, 플리즈.", "얼음 조금만 넣어 주세요."], [1.94, "t", "No ice, please.", "노우 아이스, 플리즈.", "얼음은 빼 주세요."], [3.93, "t", "Could you make it less sweet?", "쿠쥬 메이킷 레스 스위트?", "덜 달게 해 주실 수 있어요?"], [6.16, "t", "Do you have oat milk?", "두 유 해브 오우트 밀크?", "귀리 우유 있어요?"], [8.15, "t", "Yes, it's fifty cents extra.", "예스, 이츠 피프티 센츠 엑스트라.", "네, 추가 요금이 있어요."], [10.83, "t", "That's fine. Oat milk, please.", "대츠 파인. 오우트 밀크, 플리즈.", "괜찮아요. 귀리 우유로 해 주세요."], [13.61, "t", "Can I get that decaf?", "캔 아이 겟 댓 디캐프?", "디카페인으로 해 주실 수 있어요?"], [15.77, "t", "What is this one?", "왓 이즈 디스 원?", "이건 뭐예요?"], [17.6, "t", "It's a blueberry muffin.", "이처 블루베리 머핀.", "블루베리 머핀이에요."], [19.74, "t", "I'll have one of those, too.", "아일 해브 원 어브 도우즈, 투.", "그것도 하나 주세요."], [22.05, "t", "Would you like it warmed up?", "우쥬 라이킷 웜드 업?", "데워 드릴까요?"], [24.31, "t", "Yes, please.", "예스, 플리즈.", "네, 부탁해요."], [26.03, "t", "I'm sorry, we're sold out.", "아임 쏘리, 위어 쏘울드 아웃.", "죄송해요, 다 팔렸어요."], [28.53, "t", "What else do you have?", "왓 엘스 두 유 해브?", "다른 건 뭐가 있어요?"], [30.53, "t", "Can I have your name?", "캔 아이 해뷰어 네임?", "성함이 어떻게 되세요?"], [32.46, "t", "It's Kim.", "이츠 킴.", "김이에요."], [34.04, "t", "What's the Wi-Fi password?", "왓츠 더 와이파이 패스워드?", "와이파이 비밀번호가 뭐예요?"], [36.38, "t", "It's printed on your receipt.", "이츠 프린티드 온 유어 리씨트.", "영수증에 적혀 있어요."], [38.67, "t", "Is there an outlet I can use?", "이즈 데어런 아웃렛 아이 캔 유즈?", "쓸 수 있는 콘센트 있어요?"], [41.21, "t", "Is this seat taken?", "이즈 디스 씻 테이큰?", "이 자리 임자 있어요?"], [43.31, "t", "No, go ahead.", "노우, 고 어헤드.", "아니요, 앉으세요."], [45.09, "t", "Sorry, I spilled my drink.", "쏘리, 아이 스필드 마이 드링크.", "죄송해요, 음료를 쏟았어요."], [47.6, "t", "Could I get some napkins?", "쿠다이 겟 썸 냅킨즈?", "냅킨 좀 주시겠어요?"], [49.78, "t", "No worries. I'll make you a new one.", "노우 워리즈. 아일 메이큐 어 뉴 원.", "괜찮아요. 새로 만들어 드릴게요."], [52.73, "t", "That's very kind of you. Thank you.", "대츠 베리 카인드 어뷰. 쌩큐.", "친절하시네요. 감사합니다."], [55.52, "t", "Could I get a to-go cup?", "쿠다이 게러 투고우 컵?", "포장용 컵 주시겠어요?"]], "ja": [[0.0, "t", "氷は少なめでお願いします。", "코-리와 스쿠나메데 오네가이시마스.", "얼음 조금만 넣어 주세요."], [2.88, "t", "氷なしでお願いします。", "코-리 나시데 오네가이시마스.", "얼음은 빼 주세요."], [5.43, "t", "甘さ控えめにできますか。", "아마사 히카에메니 데키마스카.", "덜 달게 해 주실 수 있어요?"], [8.17, "t", "オーツミルクはありますか。", "오-츠 미루쿠와 아리마스카.", "귀리 우유 있어요?"], [10.73, "t", "はい、追加で五十円かかります。", "하이, 츠이카데 고쥬-엔 카카리마스.", "네, 추가 요금이 있어요."], [13.86, "t", "大丈夫です。オーツミルクでお願いします。", "다이죠-부데스. 오-츠 미루쿠데 오네가이시마스.", "괜찮아요. 귀리 우유로 해 주세요."], [17.98, "t", "カフェインレスにできますか。", "카훼인레스니 데키마스카.", "디카페인으로 해 주실 수 있어요?"], [20.61, "t", "これは何ですか。", "코레와 난데스카.", "이건 뭐예요?"], [22.79, "t", "ブルーベリーのマフィンです。", "부루-베리-노 마휜데스.", "블루베리 머핀이에요."], [25.25, "t", "それも一つください。", "소레모 히토츠 쿠다사이.", "그것도 하나 주세요."], [27.58, "t", "温めますか。", "아타타메마스카.", "데워 드릴까요?"], [29.63, "t", "はい、お願いします。", "하이, 오네가이시마스.", "네, 부탁해요."], [31.82, "t", "申し訳ありません、売り切れです。", "모-시와케 아리마셍, 우리키레데스.", "죄송해요, 다 팔렸어요."], [34.86, "t", "ほかに何がありますか。", "호카니 나니가 아리마스카.", "다른 건 뭐가 있어요?"], [37.39, "t", "お名前をいただけますか。", "오나마에오 이타다케마스카.", "성함이 어떻게 되세요?"], [39.94, "t", "キムです。", "키무데스.", "김이에요."], [41.73, "t", "Wi-Fiのパスワードは何ですか。", "와이화이노 파스와-도와 난데스카.", "와이파이 비밀번호가 뭐예요?"], [44.66, "t", "レシートに書いてあります。", "레시-토니 카이테 아리마스.", "영수증에 적혀 있어요."], [47.2, "t", "使えるコンセントはありますか。", "츠카에루 콘센토와 아리마스카.", "쓸 수 있는 콘센트 있어요?"], [50.08, "t", "この席は空いていますか。", "코노 세키와 아이테 이마스카.", "이 자리 임자 있어요?"], [52.6, "t", "ええ、どうぞ。", "에-, 도-조.", "아니요, 앉으세요."], [54.45, "t", "すみません、飲み物をこぼしてしまいました。", "스미마셍, 노미모노오 코보시테 시마이마시타.", "죄송해요, 음료를 쏟았어요."], [58.11, "t", "紙ナプキンをもらえますか。", "카미 나푸킨오 모라에마스카.", "냅킨 좀 주시겠어요?"], [60.75, "t", "大丈夫ですよ。新しくお作りします。", "다이죠-부데스요. 아타라시쿠 오츠쿠리시마스.", "괜찮아요. 새로 만들어 드릴게요."], [64.58, "t", "ご親切にありがとうございます。", "고신세츠니 아리가토- 고자이마스.", "친절하시네요. 감사합니다."], [67.71, "t", "持ち帰り用のカップをもらえますか。", "모치카에리요-노 캅푸오 모라에마스카.", "포장용 컵 주시겠어요?"]], "zh": [[0.0, "t", "请少放点冰。", "칭 샤오 팡 뎬 삥.", "얼음 조금만 넣어 주세요."], [2.16, "t", "请不要加冰。", "칭 부야오 쟈 삥.", "얼음은 빼 주세요."], [4.23, "t", "可以做得不那么甜吗？", "커이 쭤더 부 나머 톈 마?", "덜 달게 해 주실 수 있어요?"], [6.64, "t", "有燕麦奶吗？", "여우 옌마이나이 마?", "귀리 우유 있어요?"], [8.48, "t", "有，要加三块钱。", "여우, 야오 쟈 싼 콰이 쳰.", "네, 추가 요금이 있어요."], [10.84, "t", "没问题，请换燕麦奶。", "메이 원티, 칭 환 옌마이나이.", "괜찮아요. 귀리 우유로 해 주세요."], [13.4, "t", "可以换成低因的吗？", "커이 환청 디인 더 마?", "디카페인으로 해 주실 수 있어요?"], [15.8, "t", "这个是什么？", "쩌거 스 선머?", "이건 뭐예요?"], [17.71, "t", "是蓝莓蛋糕。", "스 란메이 단까오.", "블루베리 머핀이에요."], [19.72, "t", "那个也来一个。", "나거 예 라이 이거.", "그것도 하나 주세요."], [21.79, "t", "需要加热吗？", "쉬야오 쟈러 마?", "데워 드릴까요?"], [23.5, "t", "好的，麻烦了。", "하오 더, 마판 러.", "네, 부탁해요."], [25.54, "t", "不好意思，卖完了。", "뿌 하오이쓰, 마이완 러.", "죄송해요, 다 팔렸어요."], [27.74, "t", "还有什么别的吗？", "하이 여우 선머 비에 더 마?", "다른 건 뭐가 있어요?"], [29.87, "t", "请问怎么称呼？", "칭원 쩐머 청후?", "성함이 어떻게 되세요?"], [32.07, "t", "我姓金。", "워 싱 진.", "김이에요."], [33.88, "t", "无线网络密码是多少？", "우셴 왕뤄 미마 스 뚜어샤오?", "와이파이 비밀번호가 뭐예요?"], [36.56, "t", "写在小票上。", "셰 짜이 샤오퍄오 상.", "영수증에 적혀 있어요."], [38.69, "t", "有可以用的插座吗？", "여우 커이 융 더 차쭤 마?", "쓸 수 있는 콘센트 있어요?"], [40.97, "t", "这个位子有人吗？", "쩌거 웨이쯔 여우 런 마?", "이 자리 임자 있어요?"], [43.03, "t", "没有，请坐。", "메이여우, 칭 쭤.", "아니요, 앉으세요."], [44.92, "t", "不好意思，我把饮料弄洒了。", "뿌 하오이쓰, 워 바 인랴오 눙싸 러.", "죄송해요, 음료를 쏟았어요."], [47.84, "t", "可以给我几张纸巾吗？", "커이 게이 워 지 장 즈진 마?", "냅킨 좀 주시겠어요?"], [50.4, "t", "没关系，我给您重新做一杯。", "메이 관시, 워 게이 닌 충씬 쭤 이 뻬이.", "괜찮아요. 새로 만들어 드릴게요."], [53.38, "t", "您太客气了，谢谢。", "닌 타이 커치 러, 셰셰.", "친절하시네요. 감사합니다."], [55.79, "t", "可以给我一个外带杯吗？", "커이 게이 워 이거 와이따이 뻬이 마?", "포장용 컵 주시겠어요?"]]}