{"en": [[0.0, "t", "I'd like to see a doctor.", "아이드 라익 투 씨 어 닥터.", "진료를 받고 싶어요."], [2.3, "t", "Do you have an appointment?", "두 유 해번 어포인트먼트?", "예약하셨어요?"], [4.51, "t", "No, I don't.", "노우, 아이 돈트.", "아니요, 안 했어요."], [6.28, "t", "Please fill out this form.", "플리즈 필 아웃 디스 폼.", "이 서류를 작성해 주세요."], [8.5, "t", "What seems to be the problem?", "왓 씸즈 투 비 더 프라블럼?", "어디가 불편하세요?"], [10.84, "t", "I have a headache and a fever.", "아이 해버 헤데이크 앤 어 피버.", "머리가 아프고 열이 나요."], [13.28, "t", "I have a sore throat and a cough.", "아이 해버 쏘어 쓰로트 앤 어 코프.", "목이 아프고 기침이 나요."], [15.93, "t", "My stomach hurts.", "마이 스터먹 허츠.", "배가 아파요."], [17.87, "t", "When did it start?", "웬 디드 잇 스타트?", "언제부터 그랬어요?"], [19.81, "t", "It started yesterday.", "잇 스타티드 예스터데이.", "어제부터요."], [21.93, "t", "Take a deep breath, please.", "테이커 딥 브레쓰, 플리즈.", "숨을 깊게 들이쉬세요."], [24.31, "t", "I'm allergic to penicillin.", "아임 얼러직 투 페니씰린.", "페니실린 알레르기가 있어요."], [26.8, "t", "I'm not taking any medicine now.", "아임 낫 테이킹 애니 메디슨 나우.", "지금 먹는 약은 없어요."], [29.43, "t", "It looks like a cold. Get plenty of rest.", "잇 룩스 라이커 코울드. 겟 플렌티 어브 레스트.", "감기 같아요. 푹 쉬세요."], [32.84, "t", "Is it serious?", "이짓 씨리어스?", "심각한가요?"], [34.59, "t", "No, it's nothing serious.", "노우, 이츠 낫씽 씨리어스.", "아니요, 걱정 안 하셔도 돼요."], [37.0, "t", "Can I travel tomorrow?", "캔 아이 트래블 투모로우?", "내일 이동해도 될까요?"], [39.19, "t", "Could I get a medical certificate?", "쿠다이 게러 메디컬 써티피킷?", "진단서를 받을 수 있을까요?"], [41.88, "t", "I have travel insurance.", "아이 해브 트래블 인슈어런스.", "여행자 보험이 있어요."]], "ja": [[0.0, "t", "診察を受けたいのですが。", "신사츠오 우케타이노데스가.", "진료를 받고 싶어요."], [2.81, "t", "ご予約はありますか。", "고요야쿠와 아리마스카.", "예약하셨어요?"], [5.25, "t", "いいえ、ありません。", "이-에, 아리마셍.", "아니요, 안 했어요."], [7.31, "t", "こちらの用紙にご記入ください。", "코치라노 요-시니 고키뉴- 쿠다사이.", "이 서류를 작성해 주세요."], [10.37, "t", "今日はどうされましたか。", "쿄-와 도- 사레마시타카.", "어디가 불편하세요?"], [12.83, "t", "頭が痛くて、熱があります。", "아타마가 이타쿠테, 네츠가 아리마스.", "머리가 아프고 열이 나요."], [15.75, "t", "のどが痛くて、せきが出ます。", "노도가 이타쿠테, 세키가 데마스.", "목이 아프고 기침이 나요."], [18.59, "t", "おなかが痛いです。", "오나카가 이타이데스.", "배가 아파요."], [20.76, "t", "いつからですか。", "이츠카라데스카.", "언제부터 그랬어요?"], [22.83, "t", "昨日からです。", "키노-카라데스.", "어제부터요."], [24.87, "t", "大きく息を吸ってください。", "오-키쿠 이키오 슷테 쿠다사이.", "숨을 깊게 들이쉬세요."], [27.52, "t", "ペニシリンのアレルギーがあります。", "페니시린노 아레루기-가 아리마스.", "페니실린 알레르기가 있어요."], [30.5, "t", "今、薬は飲んでいません。", "이마, 쿠스리와 논데 이마셍.", "지금 먹는 약은 없어요."], [33.15, "t", "風邪のようです。ゆっくり休んでください。", "카제노 요-데스. 육쿠리 야슨데 쿠다사이.", "감기 같아요. 푹 쉬세요."], [37.03, "t", "重い病気ですか。", "오모이 뵤-키데스카.", "심각한가요?"], [39.25, "t", "いいえ、心配ありません。", "이-에, 심파이 아리마셍.", "아니요, 걱정 안 하셔도 돼요."], [41.75, "t", "明日、移動しても大丈夫ですか。", "아시타, 이도- 시테모 다이죠-부데스카.", "내일 이동해도 될까요?"], [44.93, "t", "診断書をもらえますか。", "신단쇼오 모라에마스카.", "진단서를 받을 수 있을까요?"], [47.5, "t", "旅行保険に入っています。", "료코- 호켄니 하잇테 이마스.", "여행자 보험이 있어요."]], "zh": [[0.0, "t", "我想看医生。", "워 샹 칸 이셩.", "진료를 받고 싶어요."], [2.05, "t", "您预约了吗？", "닌 위웨 러 마?", "예약하셨어요?"], [3.83, "t", "没有预约。", "메이여우 위웨.", "아니요, 안 했어요."], [5.57, "t", "请填一下这张表。", "칭 톈 이샤 쩌 장 뱌오.", "이 서류를 작성해 주세요."], [8.06, "t", "您哪里不舒服？", "닌 나리 뿌 슈푸?", "어디가 불편하세요?"], [10.21, "t", "我头疼，还发烧。", "워 터우텅, 하이 파샤오.", "머리가 아프고 열이 나요."], [12.45, "t", "我嗓子疼，还咳嗽。", "워 상쯔 텅, 하이 커써우.", "목이 아프고 기침이 나요."], [14.84, "t", "我肚子疼。", "워 뚜쯔 텅.", "배가 아파요."], [16.71, "t", "什么时候开始的？", "선머 스허우 카이스 더?", "언제부터 그랬어요?"], [19.07, "t", "从昨天开始的。", "충 쭤톈 카이스 더.", "어제부터요."], [21.4, "t", "请深呼吸。", "칭 선 후시.", "숨을 깊게 들이쉬세요."], [23.39, "t", "我对青霉素过敏。", "워 뚜이 칭메이쑤 궈민.", "페니실린 알레르기가 있어요."], [25.74, "t", "我现在没有在吃药。", "워 셴짜이 메이여우 짜이 츠 야오.", "지금 먹는 약은 없어요."], [28.24, "t", "看起来是感冒。请好好休息。", "칸 치라이 스 간마오. 칭 하오하오 슈시.", "감기 같아요. 푹 쉬세요."], [31.36, "t", "严重吗？", "옌중 마?", "심각한가요?"], [32.9, "t", "不严重，不用担心。", "뿌 옌중, 부융 단신.", "아니요, 걱정 안 하셔도 돼요."], [35.2, "t", "我明天可以出行吗？", "워 밍톈 커이 추싱 마?", "내일 이동해도 될까요?"], [37.66, "t", "可以开一张诊断证明吗？", "커이 카이 이 장 전돤 정밍 마?", "진단서를 받을 수 있을까요?"], [40.36, "t", "我买了旅行保险。", "워 마이 러 뤼싱 바오셴.", "여행자 보험이 있어요."]]}