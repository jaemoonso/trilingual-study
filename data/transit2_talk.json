{"en": [[0.0, "t", "Is the train delayed?", "이즈 더 트레인 딜레이드?", "기차가 늦어지나요?"], [2.1, "t", "Yes, by about thirty minutes.", "예스, 바이 어바웃 써티 미닛츠.", "네, 삼십 분쯤이요."], [4.7, "t", "Do you know what happened?", "두 유 노우 왓 해픈드?", "무슨 일인지 아세요?"], [6.78, "t", "There's a problem with the signals.", "데어저 프라블럼 위드 더 씨그널즈.", "신호에 문제가 있대요."], [9.32, "t", "Is there another way to get there?", "이즈 데어러나더 웨이 투 겟 데어?", "다른 방법으로 갈 수 있나요?"], [11.74, "t", "You can take a bus from the front exit.", "유 캔 테이커 버스 프럼 더 프런트 엑싯.", "정문에서 버스를 타시면 돼요."], [14.62, "t", "I just missed my train.", "아이 저스트 미스트 마이 트레인.", "방금 열차를 놓쳤어요."], [16.88, "t", "When is the next one?", "웬 이즈 더 넥스트 원?", "다음 건 언제예요?"], [18.9, "t", "In twenty minutes.", "인 트웬티 미닛츠.", "이십 분 뒤요."], [20.8, "t", "Can I use the same ticket?", "캔 아이 유즈 더 쎄임 티킷?", "같은 표를 써도 되나요?"], [23.26, "t", "No, please change it at the counter.", "노우, 플리즈 체인지 잇 앳 더 카운터.", "아니요, 창구에서 바꾸세요."], [26.12, "t", "I'd like to change to a later train.", "아이드 라익 투 체인지 투 어 레이러 트레인.", "더 늦은 열차로 바꾸고 싶어요."], [28.86, "t", "What time is the last train?", "왓 타임 이즈 더 래스트 트레인?", "막차가 몇 시예요?"], [31.25, "t", "It leaves at a quarter to twelve.", "잇 리브즈 애러 쿼터 투 트웰브.", "열한 시 사십오 분이에요."], [33.78, "t", "I think I left my bag on the train.", "아이 씽크 아이 레프트 마이 백 온 더 트레인.", "열차에 가방을 두고 내린 것 같아요."], [36.61, "t", "What does it look like?", "왓 더짓 룩 라익?", "어떻게 생겼나요?"], [38.57, "t", "It's a small black backpack.", "이처 스몰 블랙 백팩.", "작은 검은색 배낭이에요."], [40.99, "t", "What's inside?", "왓츠 인싸이드?", "안에는 뭐가 있어요?"], [42.78, "t", "My wallet and my passport.", "마이 월릿 앤 마이 패스포트.", "지갑과 여권이요."], [45.3, "t", "What time did you get off?", "왓 타임 디쥬 겟 오프?", "몇 시쯤 내리셨어요?"], [47.5, "t", "Around three o'clock.", "어라운드 쓰리 어클락.", "세 시쯤이요."], [49.66, "t", "We'll contact you if we find it.", "위일 컨택튜 이프 위 파인딧.", "찾으면 연락드릴게요."], [52.23, "t", "Here's my phone number.", "히어즈 마이 폰 넘버.", "이게 제 전화번호예요."], [54.37, "t", "Are we going the right way?", "아 위 고잉 더 라잇 웨이?", "맞는 길로 가고 있나요?"], [56.61, "t", "The main road is closed, so this is a detour.", "더 메인 로드 이즈 클로우즈드, 쏘 디스 이즈 어 디투어.", "큰길이 막혀서 돌아가는 거예요."], [59.99, "t", "Oh, I see. Thank you for explaining.", "오우, 아이 씨. 쌩큐 포 익스플레이닝.", "아, 그렇군요. 설명해 주셔서 감사해요."]], "ja": [[0.0, "t", "電車は遅れていますか。", "덴샤와 오쿠레테 이마스카.", "기차가 늦어지나요?"], [2.64, "t", "はい、三十分ほど遅れています。", "하이, 산즙푼 호도 오쿠레테 이마스.", "네, 삼십 분쯤이요."], [5.71, "t", "何があったか分かりますか。", "나니가 앗타카 와카리마스카.", "무슨 일인지 아세요?"], [8.4, "t", "信号に問題があるそうです。", "싱고-니 몬다이가 아루 소-데스.", "신호에 문제가 있대요."], [11.37, "t", "ほかの行き方はありますか。", "호카노 이키카타와 아리마스카.", "다른 방법으로 갈 수 있나요?"], [14.15, "t", "正面の出口からバスに乗れます。", "쇼-멘노 데구치카라 바스니 노레마스.", "정문에서 버스를 타시면 돼요."], [17.3, "t", "電車に乗り遅れてしまいました。", "덴샤니 노리오쿠레테 시마이마시타.", "방금 열차를 놓쳤어요."], [20.33, "t", "次の電車はいつですか。", "츠기노 덴샤와 이츠데스카.", "다음 건 언제예요?"], [22.98, "t", "二十分後です。", "니즙풍고데스.", "이십 분 뒤요."], [25.1, "t", "この切符はそのまま使えますか。", "코노 킵푸와 소노마마 츠카에마스카.", "같은 표를 써도 되나요?"], [28.24, "t", "いいえ、窓口で変更してください。", "이-에, 마도구치데 헹코- 시테 쿠다사이.", "아니요, 창구에서 바꾸세요."], [31.57, "t", "後の電車に変更したいです。", "아토노 덴샤니 헹코- 시타이데스.", "더 늦은 열차로 바꾸고 싶어요."], [34.55, "t", "終電は何時ですか。", "슈-뎅와 난지데스카.", "막차가 몇 시예요?"], [36.96, "t", "十一時四十五分です。", "쥬-이치지 욘쥬-고훈데스.", "열한 시 사십오 분이에요."], [39.58, "t", "電車にかばんを忘れたようです。", "덴샤니 카방오 와스레타 요-데스.", "열차에 가방을 두고 내린 것 같아요."], [42.59, "t", "どんなかばんですか。", "돈나 카방데스카.", "어떻게 생겼나요?"], [44.86, "t", "小さい黒いリュックです。", "치-사이 쿠로이 륙쿠데스.", "작은 검은색 배낭이에요."], [47.25, "t", "中には何が入っていますか。", "나카니와 나니가 하잇테 이마스카.", "안에는 뭐가 있어요?"], [50.25, "t", "財布とパスポートです。", "사이후토 파스포-토데스.", "지갑과 여권이요."], [52.66, "t", "何時ごろ降りましたか。", "난지고로 오리마시타카.", "몇 시쯤 내리셨어요?"], [55.06, "t", "三時ごろです。", "산지 고로데스.", "세 시쯤이요."], [57.08, "t", "見つかりましたらご連絡します。", "미츠카리마시타라 고렌라쿠 시마스.", "찾으면 연락드릴게요."], [59.95, "t", "これが私の電話番号です。", "코레가 와타시노 뎅와 방고-데스.", "이게 제 전화번호예요."], [63.09, "t", "この道で合っていますか。", "코노 미치데 앗테 이마스카.", "맞는 길로 가고 있나요?"], [65.68, "t", "本通りが通行止めなので、回り道しています。", "혼도-리가 츠-코-도메나노데, 마와리미치 시테 이마스.", "큰길이 막혀서 돌아가는 거예요."], [69.99, "t", "そうですか。説明してくれてありがとうございます。", "소-데스카. 세츠메- 시테 쿠레테 아리가토- 고자이마스.", "아, 그렇군요. 설명해 주셔서 감사해요."]], "zh": [[0.0, "t", "火车晚点了吗？", "훠처 완뎬 러 마?", "기차가 늦어지나요?"], [2.05, "t", "对，晚点大概三十分钟。", "뚜이, 완뎬 따가이 싼스 펀중.", "네, 삼십 분쯤이요."], [4.8, "t", "您知道是怎么回事吗？", "닌 즈다오 스 쩐머 후이 스 마?", "무슨 일인지 아세요?"], [7.37, "t", "听说是信号出了问题。", "팅슈오 스 신하오 추 러 원티.", "신호에 문제가 있대요."], [10.12, "t", "还有别的办法能到吗？", "하이 여우 비에 더 빤파 넝 따오 마?", "다른 방법으로 갈 수 있나요?"], [12.58, "t", "可以从正门出去坐公交车。", "커이 충 졍먼 추취 쭤 궁쟈오처.", "정문에서 버스를 타시면 돼요."], [15.66, "t", "我刚刚没赶上车。", "워 깡깡 메이 간상 처.", "방금 열차를 놓쳤어요."], [18.09, "t", "下一班是什么时候？", "샤 이 반 스 선머 스허우?", "다음 건 언제예요?"], [20.59, "t", "二十分钟以后。", "얼스 펀중 이허우.", "이십 분 뒤요."], [22.73, "t", "这张票还能用吗？", "쩌 장 퍄오 하이 넝 융 마?", "같은 표를 써도 되나요?"], [24.91, "t", "不能，请到窗口改签。", "뿌 넝, 칭 따오 촹커우 가이쳰.", "아니요, 창구에서 바꾸세요."], [27.57, "t", "我想改成晚一点的车。", "워 샹 가이청 완 이뎬 더 처.", "더 늦은 열차로 바꾸고 싶어요."], [30.25, "t", "末班车是几点？", "모반처 스 지 뎬?", "막차가 몇 시예요?"], [32.49, "t", "十一点四十五分。", "스이 뎬 쓰스우 펀.", "열한 시 사십오 분이에요."], [34.77, "t", "我好像把包忘在车上了。", "워 하오샹 바 빠오 왕 짜이 처상 러.", "열차에 가방을 두고 내린 것 같아요."], [37.78, "t", "是什么样的包？", "스 선머양 더 빠오?", "어떻게 생겼나요?"], [39.81, "t", "是一个黑色的小双肩包。", "스 이거 헤이써 더 샤오 솽졘빠오.", "작은 검은색 배낭이에요."], [42.62, "t", "里面装了什么？", "리몐 좡 러 선머?", "안에는 뭐가 있어요?"], [44.73, "t", "钱包和护照。", "쳰빠오 허 후자오.", "지갑과 여권이요."], [46.86, "t", "您大概几点下的车？", "닌 따가이 지 뎬 샤 더 처?", "몇 시쯤 내리셨어요?"], [49.33, "t", "三点左右。", "싼 뎬 쭤여우.", "세 시쯤이요."], [51.3, "t", "找到了我们联系您。", "쟈오다오 러 워먼 롄시 닌.", "찾으면 연락드릴게요."], [53.76, "t", "这是我的电话号码。", "쩌 스 워 더 뎬화 하오마.", "이게 제 전화번호예요."], [56.26, "t", "我们走的路对吗？", "워먼 저우 더 루 뚜이 마?", "맞는 길로 가고 있나요?"], [58.36, "t", "主路封了，所以绕一下。", "주루 펑 러, 쑤오이 라오 이샤.", "큰길이 막혀서 돌아가는 거예요."], [60.83, "t", "原来如此，谢谢您解释。", "위안라이 루츠, 셰셰 닌 졔스.", "아, 그렇군요. 설명해 주셔서 감사해요."]]}