{"en": [[0.0, "t", "Could you open the trunk, please?", "쿠쥬 오픈 더 트렁크, 플리즈?", "트렁크 좀 열어 주시겠어요?"], [2.42, "t", "Sure, I'll help you with that.", "슈어, 아일 헬퓨 위드 댓.", "네, 도와드릴게요."], [4.83, "t", "Where to?", "웨어 투?", "어디로 모실까요?"], [6.38, "t", "To the airport, please.", "투 디 에어포트, 플리즈.", "공항으로 가 주세요."], [8.55, "t", "Please take me to this address.", "플리즈 테이크 미 투 디스 어드레스.", "이 주소로 가 주세요."], [11.01, "t", "How long will it take?", "하우 롱 윌 잇 테이크?", "얼마나 걸릴까요?"], [13.12, "t", "About forty minutes, if the traffic is okay.", "어바웃 포티 미닛츠, 이프 더 트래픽 이즈 오케이.", "길이 안 막히면 사십 분쯤이에요."], [16.5, "t", "I'm in a hurry. Could you take the fastest way?", "아임 인 어 허리. 쿠쥬 테이크 더 패스티스트 웨이?", "급해서요. 가장 빠른 길로 가 주실 수 있어요?"], [20.09, "t", "Then I'll take the highway. There's a toll.", "덴 아일 테이크 더 하이웨이. 데어즈 어 토울.", "그럼 고속도로로 갈게요. 통행료가 있어요."], [23.16, "t", "That's fine.", "대츠 파인.", "괜찮아요."], [24.79, "t", "Could you turn up the air conditioning?", "쿠쥬 턴 업 디 에어 컨디셔닝?", "에어컨 좀 세게 해 주시겠어요?"], [27.37, "t", "Is it okay if I open the window?", "이짓 오케이 이프 아이 오픈 더 윈도우?", "창문 열어도 될까요?"], [30.22, "t", "Is there a lot of traffic?", "이즈 데어러 랏 어브 트래픽?", "차가 많이 막혀요?"], [32.51, "t", "Yes, there's an accident ahead.", "예스, 데어즈 언 액씨던트 어헤드.", "네, 앞에 사고가 났어요."], [35.17, "t", "You can stop here.", "유 캔 스탑 히어.", "여기서 세워 주세요."], [37.13, "t", "Could you stop at the next corner?", "쿠쥬 스탑 앳 더 넥스트 코너?", "다음 모퉁이에서 세워 주시겠어요?"], [39.65, "t", "How much is it?", "하우 머치 이즈 잇?", "얼마예요?"], [41.5, "t", "It's thirty-two dollars.", "이츠 써티 투 달러즈.", "요금은 이만큼이에요."], [43.75, "t", "Do you take credit cards?", "두 유 테이크 크레딧 카즈?", "신용카드 돼요?"], [46.03, "t", "Keep the change.", "킵 더 체인지.", "잔돈은 괜찮아요."], [47.87, "t", "Can I have a receipt?", "캔 아이 해버 리씨트?", "영수증 주시겠어요?"], [49.9, "t", "Wait, I left my bag in the trunk.", "웨이트, 아이 레프트 마이 백 인 더 트렁크.", "잠깐만요, 트렁크에 짐이 있어요."]], "ja": [[0.0, "t", "トランクを開けてもらえますか。", "토랑쿠오 아케테 모라에마스카.", "트렁크 좀 열어 주시겠어요?"], [2.7, "t", "はい、お手伝いします。", "하이, 오테츠다이시마스.", "네, 도와드릴게요."], [5.03, "t", "どちらまで行きますか。", "도치라마데 이키마스카.", "어디로 모실까요?"], [7.44, "t", "空港までお願いします。", "쿠-코-마데 오네가이시마스.", "공항으로 가 주세요."], [9.96, "t", "この住所までお願いします。", "코노 쥬-쇼마데 오네가이시마스.", "이 주소로 가 주세요."], [12.77, "t", "どのくらいかかりますか。", "도노쿠라이 카카리마스카.", "얼마나 걸릴까요?"], [15.32, "t", "道がすいていれば四十分くらいです。", "미치가 스이테 이레바 욘즙푼 쿠라이데스.", "길이 안 막히면 사십 분쯤이에요."], [18.73, "t", "急いでいます。一番早い道でお願いできますか。", "이소이데 이마스. 이치방 하야이 미치데 오네가이 데키마스카.", "급해서요. 가장 빠른 길로 가 주실 수 있어요?"], [23.7, "t", "では高速で行きます。料金所の代金がかかります。", "데와 코-소쿠데 이키마스. 코-소쿠 료-킹가 카카리마스.", "그럼 고속도로로 갈게요. 통행료가 있어요."], [29.01, "t", "それで大丈夫です。", "소레데 다이죠-부데스.", "괜찮아요."], [31.33, "t", "エアコンを強くしてもらえますか。", "에아콘오 츠요쿠 시테 모라에마스카.", "에어컨 좀 세게 해 주시겠어요?"], [34.34, "t", "窓を開けてもいいですか。", "마도오 아케테모 이-데스카.", "창문 열어도 될까요?"], [36.94, "t", "渋滞していますか。", "쥬-타이 시테 이마스카.", "차가 많이 막혀요?"], [39.27, "t", "はい、この先で事故があったようです。", "하이, 코노 사키데 지코가 앗타 요-데스.", "네, 앞에 사고가 났어요."], [42.39, "t", "ここで止めてください。", "코코데 토메테 쿠다사이.", "여기서 세워 주세요."], [44.83, "t", "次の角で止めてもらえますか。", "츠기노 카도데 토메테 모라에마스카.", "다음 모퉁이에서 세워 주시겠어요?"], [47.86, "t", "おいくらですか。", "오이쿠라데스카.", "얼마예요?"], [49.86, "t", "三千二百円です。", "산젠니햐쿠엔데스.", "요금은 이만큼이에요."], [52.27, "t", "クレジットカードは使えますか。", "쿠레짓토 카-도와 츠카에마스카.", "신용카드 돼요?"], [55.16, "t", "おつりは結構です。", "오츠리와 켁코-데스.", "잔돈은 괜찮아요."], [57.42, "t", "領収書をもらえますか。", "료-슈-쇼오 모라에마스카.", "영수증 주시겠어요?"], [59.98, "t", "待ってください、トランクに荷物があります。", "맛테 쿠다사이, 토랑쿠니 니모츠가 아리마스.", "잠깐만요, 트렁크에 짐이 있어요."]], "zh": [[0.0, "t", "麻烦打开一下后备箱好吗？", "마판 다카이 이샤 허우베이샹 하오 마?", "트렁크 좀 열어 주시겠어요?"], [2.98, "t", "好的，我帮您。", "하오 더, 워 빵 닌.", "네, 도와드릴게요."], [4.95, "t", "您去哪儿？", "닌 취 날?", "어디로 모실까요?"], [6.81, "t", "去机场，麻烦了。", "취 지창, 마판 러.", "공항으로 가 주세요."], [9.07, "t", "请带我去这个地址。", "칭 따이 워 취 쩌거 디즈.", "이 주소로 가 주세요."], [11.62, "t", "大概要多长时间？", "따가이 야오 뚜어창 스졘?", "얼마나 걸릴까요?"], [13.99, "t", "不堵车的话，四十分钟左右。", "뿌 두처 더 화, 쓰스 펀중 쭤여우.", "길이 안 막히면 사십 분쯤이에요."], [16.89, "t", "我赶时间。可以走最快的路吗？", "워 간 스졘. 커이 저우 쭈이 콰이 더 루 마?", "급해서요. 가장 빠른 길로 가 주실 수 있어요?"], [19.97, "t", "那走高速吧，要收过路费。", "나 저우 가오쑤 바, 야오 셔우 궈루페이.", "그럼 고속도로로 갈게요. 통행료가 있어요."], [22.83, "t", "可以的。", "커이 더.", "괜찮아요."], [24.24, "t", "可以把空调开大一点吗？", "커이 바 쿵탸오 카이 따 이뎬 마?", "에어컨 좀 세게 해 주시겠어요?"], [26.86, "t", "我可以开窗户吗？", "워 커이 카이 창후 마?", "창문 열어도 될까요?"], [29.06, "t", "堵车吗？", "두처 마?", "차가 많이 막혀요?"], [30.47, "t", "对，前面出事故了。", "뚜이, 쳰몐 추 스구 러.", "네, 앞에 사고가 났어요."], [32.91, "t", "在这儿停就行。", "짜이 쩔 팅 쥬 싱.", "여기서 세워 주세요."], [35.13, "t", "可以在下一个路口停吗？", "커이 짜이 샤 이거 루커우 팅 마?", "다음 모퉁이에서 세워 주시겠어요?"], [37.78, "t", "多少钱？", "뚜어샤오 쳰?", "얼마예요?"], [39.53, "t", "一百二十块。", "이바이 얼스 콰이.", "요금은 이만큼이에요."], [41.54, "t", "可以刷卡吗？", "커이 슈아카 마?", "신용카드 돼요?"], [43.43, "t", "不用找了。", "부융 쟈오 러.", "잔돈은 괜찮아요."], [45.24, "t", "可以给我发票吗？", "커이 게이 워 파퍄오 마?", "영수증 주시겠어요?"], [47.34, "t", "等一下，我的行李还在后备箱。", "덩 이샤, 워 더 싱리 하이 짜이 허우베이샹.", "잠깐만요, 트렁크에 짐이 있어요."]]}